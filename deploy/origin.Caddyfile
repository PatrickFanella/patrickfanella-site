{
    auto_https off
    admin off
}

:8080 {
    handle /healthz {
        respond "ok" 200
    }
    handle {
        root * /srv/current
        encode zstd gzip
        header {
            Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'"
            X-Robots-Tag "index, follow"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "no-referrer"
            -Server
        }
        # Public asset paths without a content hash must be revalidated.
        @hashed path /_astro/* /clpr/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        @pages not path /_astro/* /clpr/*
        header @pages Cache-Control "no-cache"
        file_server
    }
}
