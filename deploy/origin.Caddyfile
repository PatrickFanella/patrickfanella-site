{
    auto_https off
    admin off
}

:8080 {
    encode zstd gzip
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'"
        X-Robots-Tag "index, follow"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    handle /healthz {
        respond "ok" 200
    }
    # Keep lazy worker imports from an older open page available after a switch.
    @immutable path_regexp immutable ^/(_astro/.+[.-][A-Za-z0-9_-]{8}\.[A-Za-z0-9]+|clpr/[a-f0-9]{40}/.+)$
    handle @immutable {
        root * /srv/assets
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/current
        header Cache-Control "no-cache"
        file_server
    }
}
