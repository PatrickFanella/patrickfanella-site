{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/render-resume.mjs --check && node scripts/check-clpr-recording.mjs && node scripts/check-site-facts.mjs && astro check && tsc --noEmit && tsc --noEmit -p e2e && astro build",
    "record:clpr": "npm run build && node scripts/record-clpr.mjs && npm run build",
    "lighthouse:ci": "node scripts/lighthouse.mjs --local",
    "check:live": "node scripts/check-live-routes.mjs",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit -p e2e",
    "preview": "astro preview",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "render:resume": "node scripts/render-resume.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-pgvector": "0.0.17",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@webgpu/types": "^0.1.74",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "sharp": "0.35.5",
    "typescript": "~5.9.3",
    "vitest": "5.1.1"
  }
}
