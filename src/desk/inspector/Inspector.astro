---
import data from './recorded-run.json'
import { checkoutLiveGate } from './live-policy'
import { parseRecording, tableSizes } from './recording.mjs'
import { number, responseMarkup, sqlMarkup, timingMarkup, wireMarkup, planMarkup } from './render'
const recording = parseRecording(data)
const { meta } = recording
const result = recording.results[0]
const fixtureBody = JSON.parse(result.response.body) as { query: string; results: { clips: { title: string }[] } }
const samplePlan = result.plan
const largest = number(tableSizes.at(-1)!)

const gate = checkoutLiveGate(meta)
const startLabel = `Start Clpr live mode (${(meta.downloadBytes / 1e6).toFixed(2)} MB download; ${Math.ceil(meta.memory.peakBytes / 1048576).toLocaleString('en-US')} MiB measured peak)`
---
<div class="inspector" data-inspector data-mode="recorded" data-live-allowed={String(gate.allowed)} data-live-reason={gate.reason} data-live-label={startLabel}>
  <div class="evidence-entry">
    <h3>Try a clip search</h3>
    <p><a href="https://clpr.tv">Clpr is the production app</a>. This Desk demonstrates its pinned PostgreSQL search path against eight labelled fixture clips.</p>
    <p><strong>Recorded example: {fixtureBody.query}</strong>. {fixtureBody.results.clips.length} returned clips:</p>
    <ul>{fixtureBody.results.clips.map(clip => <li>{clip.title}</li>)}</ul>
    <p>Recorded plan comparison at {samplePlan.rows.toLocaleString('en-US')} clips: sequential cost {samplePlan.seq.Plan['Total Cost']}, GIN cost {samplePlan.gin.Plan['Total Cost']}. These are planner estimates, not milliseconds or production measurements. The Plan tab contains all five sizes and the captured plans.</p>
    <p>The live example searches fixtures in this tab. The separate SQL benchmark loads generated data; it does not query the production service. Nothing heavy starts until you choose a live action.</p>
  </div>
  <div data-inspector-recording>
    <p><strong>Recorded run</strong>, <time datetime={meta.recordedAt}>{meta.recordedAt.slice(0, 10)}</time>.
      {meta.ciRun ? <a href={meta.ciRun}>Recorded in CI</a> : 'Recorded locally in headless Chromium'} {meta.browser}, PostgreSQL {meta.postgres}; all {meta.migrations} migrations.</p>
    <p>Source: <a href={`https://github.com/subculture-collective/clpr/tree/${meta.clprCommit}`}>Clpr {meta.clprCommit.slice(0, 7)}</a>;
      <a href={`https://github.com/PatrickFanella/patrickfanella-site/tree/${meta.siteCommit}`}>site {meta.siteCommit.slice(0, 7)}</a>.
      These results were recorded elsewhere; they are not measurements from your device.</p>
    <p>{(meta.downloadBytes / 1e6).toFixed(2)} MB of worker payloads, including {(meta.wasmGzipBytes / 1e6).toFixed(2)} MB compressed Clpr Wasm.
      Startup {(meta.startupMs / 1000).toFixed(1)} s. Sampled peak Chromium process-tree RSS: {Math.ceil(meta.memory.peakBytes / 1048576).toLocaleString('en-US')} MiB;
      budget {meta.budget.maxPeakRssBytes / 1048576} MiB. Includes WebAssembly and shared pages counted per process; sampled every {meta.memory.sampleIntervalMs} ms through {largest} clips. Device use can differ.</p>
    <details><summary>Recording provenance</summary><p>Platform: {meta.platform}. Memory samples: {meta.memory.samples}.</p>
      <pre tabindex="0">{`Source fingerprint: ${meta.sourceFingerprint}\nBuilt worker SHA-256: ${meta.workerSha256}`}</pre></details>
    {!gate.allowed && <p>{gate.reason} The recorded run remains readable.</p>}
  </div>
  <p data-inspector-request>Recorded GET {result.url} · HTTP {result.response.status} · {result.rows} fixture clips. Plan samples cover {tableSizes[0]} through {largest} clips.</p>
  <div data-inspector-tabs hidden aria-label="Search inspector"></div>
  <section id="inspector-response" aria-labelledby="inspector-response-title" tabindex="0">
    <h3 id="inspector-response-title">Response</h3>
    <div data-inspector-response set:html={responseMarkup(result)} />
  </section>
  <section id="inspector-sql" aria-labelledby="inspector-sql-title" tabindex="0">
    <h3 id="inspector-sql-title">SQL</h3>
    <div data-inspector-sql set:html={sqlMarkup(result)} />
  </section>
  <section id="inspector-timing" aria-labelledby="inspector-timing-title" tabindex="0">
    <h3 id="inspector-timing-title">Timing</h3>
    <div data-inspector-timing set:html={timingMarkup(result)} />
  </section>
  <section id="inspector-wire" aria-labelledby="inspector-wire-title" tabindex="0">
    <h3 id="inspector-wire-title">Wire</h3>
    <div data-inspector-wire set:html={wireMarkup(result)} />
  </section>
  <section id="inspector-plan" aria-labelledby="inspector-plan-title" tabindex="0">
    <h3 id="inspector-plan-title">Plan</h3>
    <p>Compare sequential and GIN plans for the captured clip search. Eight labelled fixtures stay in the table at every size; extra clips are generated in this tab.</p>
    <form data-plan-size hidden>
      <label for="plan-rows">Table size</label>
      <select id="plan-rows" name="rows">
        <Fragment set:html={tableSizes.map(rows => `<option value="${rows}">${number(rows)} clips</option>`).join('\n        ')} />
      </select>
      <button type="submit">Resize and compare plans</button>
    </form>
    <p data-plan-status role="status">Recorded plans for world record; each resize ran VACUUM FULL and ANALYZE before planning.</p>
    <div data-plan-output set:html={planMarkup(recording.results.map(result => result.plan), result.plan, false)} />
  </section>
</div>
