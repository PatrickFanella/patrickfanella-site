---
import SiteHeader from '../components/SiteHeader.astro'
import { recruitingEmail } from '../content/contact'
import Page from '../layouts/Page.astro'
import { employmentFeature, featuredProjects } from '../content/project-presentation'
---
<Page title="Patrick Fanella" description="Patrick Fanella, senior backend and full-stack engineer. Working software, source-linked case studies, projects and résumé. Chicago or remote, and interviewing now." bodyClass="landing">
  <a class="skip" href="#coming">Skip to the work</a>

  <SiteHeader />

  <main>
    <section class="hero" aria-labelledby="name">
      <h1 id="name" class="name" data-pour-in><span data-fit><span data-word>Patrick</span> <span data-word>Fanella</span></span></h1>
      <div class="tank">
        <div class="intro panel">
          <p class="role">Senior backend and full-stack engineer</p>
          <p>Chicago or remote. Interviewing now.</p>
          <p class="hero-proof">At DeliverZero, my inventory, returns and partner integrations cut manual operations work by about 25%.</p>
          <div class="actions">
            <a class="btn primary" href="#coming" data-bleed="o" data-splash="o">View selected work</a>
            <a class="btn" href="/assets/patrick_fanella_resume.pdf" download="Patrick_Fanella_Resume.pdf">Résumé PDF</a>
          </div>
          <p class="hero-depth"><a href="/desk/">Open the engineering Desk</a> to inspect recorded search evidence or opt in to run it.</p>
        </div>
        <dl class="readout" data-ink-readout aria-label="Ink simulation">
          <div><dt>Solver</dt><dd data-k="path">Stable fluids</dd></div>
          <div><dt>Grid</dt><dd data-k="grid">…</dd></div>
          <div><dt>Rate</dt><dd data-k="fps">…</dd></div>
          <div><dt>GPU</dt><dd data-k="gpu">…</dd></div>
        </dl>
      </div>
    </section>

    <section id="coming" class="coming" aria-labelledby="coming-h">
      <div class="coming-head">
        <h2 id="coming-h">Selected work</h2>
        <p>Run the software, inspect its evidence, or read the source beside the decisions that shaped it.</p>
        <p class="dim">Looking for experience and results? Read the <a href="/resume/">résumé</a> or <a href="/contact/">get in touch</a>.</p>
      </div>
      <div class="featured-work">
        <article class="employment-feature panel">
          <p class="dim">Employment impact</p>
          <h3>{employmentFeature.title}</h3>
          <p>{employmentFeature.ownership}</p>
          <p>{employmentFeature.outcome}</p>
          <a href={employmentFeature.href}>Read the DeliverZero experience</a>
        </article>
        {featuredProjects.map(({ project, ownership, media, dimensions, study }) => <article class="featured-project panel">
          <figure>
            <img src={media.src} srcset={'srcSet' in media ? media.srcSet : undefined} sizes="(max-width: 860px) calc(100vw - 32px), 60vw" width={dimensions.width} height={dimensions.height} alt={media.alt} loading="lazy" decoding="async" />
            <figcaption>{media.caption}</figcaption>
          </figure>
          <div class="featured-copy">
            <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
            <p>{project.summary}</p><p>{ownership}</p>
            <nav aria-label={`${project.title} destinations`}>
              <a href={`/projects/${project.slug}/`}>Read the project</a>
              {study && <a href={study}>Search decisions study</a>}
              <a href={project.liveUrl}>Open {project.title}</a>
            </nav>
          </div>
        </article>)}
        <div class="featured-more panel">
          <p><a href="/desk/">Open the engineering Desk</a>: read recorded search evidence, then opt in to run Clpr’s pinned search code in your browser.</p>
          <p>For the data and search story, read <a href="/projects/hasanara/">HasanAra</a> and its <a href="/projects/rekolekt/">Rekolekt core</a>.</p>
          <p><a href="/projects/">Browse all 40 projects</a> or <a href="/motion/">explore the motion set</a>.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <p>Patrick Fanella. Software, sound, culture.</p>
    <nav aria-label="Contact">
      <a href={`mailto:${recruitingEmail}`} data-bleed="y">{recruitingEmail}</a>
      <a href="https://github.com/PatrickFanella" data-bleed="c">GitHub</a>
      <a href="https://linkedin.com/in/patrick-fanella" data-bleed="o">LinkedIn</a>
    </nav>
  </footer>
  <Fragment slot="head"><script>import '../landing.ts'</script></Fragment>
</Page>
