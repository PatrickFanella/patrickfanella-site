---
import { recruitingEmail } from '../content/contact'
import resume from '../content/resume.json'
import ContentPage from '../layouts/ContentPage.astro'
---
<ContentPage title="Contact | Patrick Fanella" description="Contact Patrick Fanella about senior backend and full-stack engineering roles. Chicago or remote, and interviewing now.">
  <h1>Contact</h1>
  <p class="lead contact-lead">I’m interviewing now for senior backend and full-stack engineering roles, in Chicago or remote.</p>
  <p class="contact-email"><a href={`mailto:${recruitingEmail}`}>{recruitingEmail}</a></p>
  <ul class="contact-links" aria-label="Profiles and résumé">
    <li><a href={resume.linkedin}>LinkedIn</a></li>
    <li><a href={resume.github}>GitHub</a></li>
    <li><a href="/resume/">Résumé</a></li>
  </ul>
  <p>To see the work first, browse the <a href="/projects/">projects</a> or inspect Clpr’s search on the <a href="/desk/">Desk</a>.</p>
</ContentPage>
<style>
.content-main .contact-lead { margin-bottom: 1.5rem; }
.contact-email { font: 700 clamp(1.25rem, 4vw, 1.75rem)/1.3 var(--mono); overflow-wrap: anywhere; }
.contact-links { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; list-style: none; margin: 1.25rem 0 2.5rem; padding: 0; }
.contact-links a { display: inline-block; padding: .5rem 0; }
</style>
