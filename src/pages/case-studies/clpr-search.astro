---
import ContentPage from '../../layouts/ContentPage.astro'
import CaseStudy from '../../components/CaseStudy.astro'
import { clprRanking } from '../../content/case-studies/clpr-ranking'
---
<ContentPage title="How Clpr ranks and pages search | Patrick Fanella" description={clprRanking.description} readingSurface ogType="article" socialImage="/assets/projects/social/clpr.png" socialAlt="Clpr’s public Discover collections view." seo={{ breadcrumbs: [{ name: 'Home', href: '/' }, { name: 'Case studies', href: '/case-studies/' }, { name: 'Clpr ranking study', href: '/case-studies/clpr-search/' }] }}>
  <CaseStudy study={clprRanking}>
    <p slot="intro" class="source-note study-scope">For each choice in this implementation: what it supports, the tradeoff it carries and what would make me revisit it. The performance tradeoffs are qualitative; none of this is a latency measurement.</p>
  </CaseStudy>
  <p class="source-note">This is a reading of the pinned PostgreSQL repository. Each note links to the exact lines it discusses. The archive’s path and hash appear below the excerpt. The source pin does not establish which backend currently serves clpr.tv.</p>
  <p>Next: <a href="/case-studies/clpr-request/">read the request setup</a>, or <a href="/desk/">open the Desk</a>.</p>
  <script>import '../../case-study.ts'</script>
</ContentPage>
<style>.study-scope { border-left: 3px solid var(--line); padding-left: 1rem; margin: 0 0 2rem; }</style>
