---
import ContentPage from '../../layouts/ContentPage.astro'
import ProjectMedia from '../../components/ProjectMedia.astro'
import { featuredProjects } from '../../content/project-presentation'
import { catalog } from '../../content/projects.mjs'
import { listNames, NumberWord, numberWord } from '../../content/number-words.mjs'
const studyCount = numberWord(catalog.studied.length)
---
<ContentPage title="Engineering case studies | Patrick Fanella" description={`${NumberWord(catalog.studied.length)} source-backed engineering case studies: ${listNames(catalog.studied.map(project => project.title))}.`}>
  <h1>Case studies</h1>
  <p class="lead">The problem, the decisions and the evidence behind {studyCount} products I built. Each study says what the product does today, links to the exact commits it describes and dates its screenshots.</p>
  <ul class="project-list">{featuredProjects.map(project => <li><article>
    <ProjectMedia media={project.media[0]} sizes="(max-width: 600px) calc(100vw - 32px), 340px" />
    <div class="project-list-copy"><h2><a href={project.study.path}>{project.title}</a></h2><p>{project.study.description}</p><a href={project.study.path}>Read the case study</a></div>
  </article></li>)}</ul>
  <section><h2 class="group-title">Inside the search implementation</h2>
    <p>Clpr also has two line-by-line code studies and an opt-in database demonstration.</p>
    <ul><li><a href="/case-studies/clpr-search/">Ranking, counts, snippets and pagination</a></li><li><a href="/case-studies/clpr-request/">Request setup and result types</a></li><li><a href="/desk/">The engineering Desk</a></li></ul>
  </section>
</ContentPage>
