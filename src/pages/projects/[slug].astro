---
import ContentPage from '../../layouts/ContentPage.astro'
import ProjectMedia from '../../components/ProjectMedia.astro'
import { allProjects, reviewedOn, type Project } from '../../content/project-presentation'
import provenance from '../../content/portfolio-provenance.json'

export function getStaticPaths() {
  return allProjects.map(project => ({ params: { slug: project.slug }, props: { project } }))
}
interface Props { project: Project }
const { project } = Astro.props
const { current, evidence } = project
const source = `https://github.com/${provenance.repository}/blob/${provenance.commit}/${provenance.file}`
const seo = { breadcrumbs: [{ name: 'Home', href: '/' }, { name: 'Work', href: '/projects/' }, { name: project.title, href: project.path }] }
---
<ContentPage title={`${project.title} | Patrick Fanella`} description={project.summary} ogType="article" socialImage={project.socialImage} socialAlt={project.thumbnailAlt ?? `${project.title} project image`} noindex={!current} seo={seo}>

  <article class="project-detail">
    <a href={current ? `/projects/#${project.slug}` : '/projects/'}>All projects</a>
    {!current && <p class="source-note">Historical project entry, kept so existing links still work. It shows the project as the earlier portfolio snapshot recorded it. It is not in the current selection, and I have not rechecked it as a live service.</p>}
    <header>
      <h1 data-project-name={project.slug}>{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <dl class="project-facts">
        <div><dt>Status</dt><dd>{project.deliveryStatus ?? 'Status not stated in source'}</dd></div>
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Period</dt><dd>{project.periodLabel ?? project.year}</dd></div>
      </dl>
      <nav class="project-links" aria-label="Project links">
        {project.study && <a href={project.study.path}>Read the case study</a>}
        {project.furtherStudies.map(study => <a href={study.href}>{study.label}</a>)}
        {project.liveUrl && <a href={project.liveUrl}>Visit {project.title}</a>}
        {project.repoUrl && <a href={project.repoUrl}>Repository</a>}
        {project.sourceUrl && <a href={project.sourceUrl}>Download source</a>}
      </nav>
    </header>
    {project.media[0] && <ProjectMedia media={project.media[0]} sizes="(max-width: 1080px) calc(100vw - 32px), 1048px" loading="eager" />}
    <section>
      <h2>Product and scope</h2>
      <p>{project.description || project.summary}</p>
      <dl class="project-facts"><div><dt>Stack</dt><dd>{project.stack.join(', ') || 'Not specified in source'}</dd></div></dl>
    </section>
    {project.problem && <section><h2>The problem</h2><p>{project.problem}</p></section>}
    {project.highlights.length > 0 && <section><h2>What I built</h2><ul>{project.highlights.map(text => <li>{text}</li>)}</ul></section>}
    {project.architecture.length > 0 && <section><h2>How it fits together</h2>{project.architecture.map(text => <p>{text}</p>)}</section>}
    {project.media.slice(1).map(media => <ProjectMedia media={media} sizes="(max-width: 1080px) calc(100vw - 32px), 1048px" />)}
    {project.lessons.length > 0 && <section><h2>What I learned</h2><ul>{project.lessons.map(text => <li>{text}</li>)}</ul></section>}
    {project.relatedProjects && <section><h2>Related work</h2><ul>{project.relatedProjects.map(related => <li><a href={`/projects/${related.slug}/`}>{related.label}</a>: {related.relationship}</li>)}</ul></section>}
    {evidence ? <p class="source-note">Copy reviewed {reviewedOn} against the <a href={evidence.readmeUrl}>pinned project source</a>. Images retain their own capture dates. Repository scope and screenshots do not establish every release or device qualification.</p> : <p class="source-note">Historical content from the <a href={source}>pinned portfolio catalog</a>, commit <code>{provenance.commit.slice(0, 7)}</code>, dated November 13, 2026.</p>}
  </article>
</ContentPage>
