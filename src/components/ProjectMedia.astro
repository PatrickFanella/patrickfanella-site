---
import assets from '../content/project-assets-provenance.json'
import type { ProjectMedia } from '../content/project-presentation'

interface Props {
  media: ProjectMedia
  sizes: string
  loading?: 'eager' | 'lazy'
}
const { media, sizes, loading = 'lazy' } = Astro.props
const dimensions = assets.files.find(file => file.path === media.src)!
---
<figure>
  <img src={media.src} width={dimensions.width} height={dimensions.height} srcset={'srcSet' in media ? media.srcSet : undefined} sizes={sizes} alt={media.alt} loading={loading} decoding="async" />
  <figcaption>{media.caption}</figcaption>
</figure>
