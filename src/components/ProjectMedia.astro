---
import type { ProjectMedia } from '../content/project-presentation'

interface Props {
  media: ProjectMedia
  sizes: string
  loading?: 'eager' | 'lazy'
}
const { media, sizes, loading = 'lazy' } = Astro.props
---
<figure>
  <img src={media.src} width={media.width} height={media.height} srcset={media.srcSet} sizes={sizes} alt={media.alt} loading={loading} decoding="async" />
  <figcaption>{media.caption}</figcaption>
</figure>
