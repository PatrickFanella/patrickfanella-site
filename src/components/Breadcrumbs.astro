---
import type { Breadcrumb } from '../content/site-metadata'
interface Props { items: Breadcrumb[] }
const { items } = Astro.props
---
{items.length > 1 && <nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>{items.map((item, index) => <li>
    {index === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}
  </li>)}</ol>
</nav>}
