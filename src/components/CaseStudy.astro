---
import Code from 'astro/components/Code.astro'
import type { ShikiTransformer } from 'shiki'
import type { CaseStudy as Study, CaseStudyNote } from '../content/case-studies/clpr-search'
interface Props { study: Study }
const { study } = Astro.props
const lines = study.sourceText.split('\n')
if (study.excerptStart < 1 || study.excerptEnd > lines.length || study.excerptStart > study.excerptEnd) throw new Error('Invalid source excerpt range')
const sections: { note?: CaseStudyNote; start: number; end: number }[] = []
let cursor = study.excerptStart
for (const note of study.notes) {
  if (note.startLine < cursor || note.endLine > study.excerptEnd || note.endLine < note.startLine) throw new Error('Notes must be ordered, nonoverlapping and within the source excerpt')
  if (cursor < note.startLine) sections.push({ start: cursor, end: note.startLine - 1 })
  sections.push({ note, start: note.startLine, end: note.endLine })
  cursor = note.endLine + 1
}
if (cursor <= study.excerptEnd) sections.push({ start: cursor, end: study.excerptEnd })
function annotation(start: number, note?: CaseStudyNote): ShikiTransformer {
  return { line(node, line) {
    const number = start + line - 1
    node.properties.id = `L${number}`
    node.properties['data-line'] = number
    if (note) node.properties.class = 'line highlighted'
    if (note && number === note.startLine) node.properties.style = `anchor-name: --line-${note.id}`
    const text = node.children
    node.children = [
      { type: 'element', tagName: 'a', properties: { class: 'line-number', href: `${study.source}#L${number}`, 'aria-label': `Open source line ${number} on GitHub` }, children: [{ type: 'text', value: String(number) }] },
      { type: 'element', tagName: 'span', properties: { class: 'line-text' }, children: text },
    ]
    if (note && number === note.startLine) node.children.push({ type: 'element', tagName: 'a', properties: { class: 'line-note-label', href: `#note-${note.id}` }, children: [{ type: 'text', value: `Note: ${note.label}` }] })
  } }
}
---
<article class="case-study" aria-labelledby="study-title">
  <header><h1 id="study-title">{study.title}</h1><p class="lead">{study.description}</p></header>
  <p class="source-label"><a href={`${study.source}#L${study.excerptStart}-L${study.excerptEnd}`}>Open pinned source on GitHub</a></p>
  <div class="study-grid" aria-label="Source and reading notes">
    {sections.map(({ note, start, end }) => <section class="excerpt-row" data-note={note?.id} aria-label={note ? `${note.label} annotation` : `Unannotated excerpt ${start} to ${end}`}>
      <div class="source" tabindex="0" role="region" aria-label={`Source lines ${start} to ${end}`}>
        <Code code={lines.slice(start - 1, end).join('\n') + '\n'} lang="go" themes={{ light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' }} transformers={[annotation(start, note)]} />
      </div>
      {note && <aside class="note" id={`note-${note.id}`} style={`position-anchor: --line-${note.id}`}><h2>{note.label}</h2><p class="line-label">Lines <a href={`${study.source}#L${note.startLine}-L${note.endLine}`}>{note.startLine}–{note.endLine}</a></p><p>{note.body}</p>
        {note.cost && <p><strong>Tradeoff.</strong> {note.cost}</p>}
        {note.change && <p><strong>When I would revisit it.</strong> {note.change}</p>}
      </aside>}
    </section>)}
  </div>
  <p class="source-note">Commit <code>{study.commit}</code>, <code>{study.path}</code>. Archived source SHA-256: <code>{study.sha256}</code>.</p>
</article>
<style>
.case-study { max-width: 1200px; margin: 0 auto; }
.case-study header { max-width: 800px; }
.case-study h1 { font-size: clamp(2.5rem, 6vw, 5rem); }
.source-label, .line-label { font: .75rem/1.5 var(--mono); color: var(--dim); }
.source-label { margin-bottom: .75rem; }
.study-grid { display: grid; }
.excerpt-row { position: relative; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 1fr); align-items: start; gap: 1.25rem; }
.source { min-width: 0; overflow: auto; border: 1px solid var(--line); background: var(--raise-solid); }
.source :global(pre) { margin: 0; padding: .75rem; font: .75rem/1.75 var(--mono); tab-size: 4; background: transparent !important; }
.source :global(pre > code) { display: grid; }
.source :global(.line) { display: grid; grid-template-columns: 4ch max-content max-content; min-width: max-content; scroll-margin: 5rem; }
.source :global(.line-number) { color: var(--dim); text-align: right; padding-right: 1ch; text-decoration: none; }
.source :global(.line-number:hover) { text-decoration: underline; }
.source :global(.line-text) { white-space: pre; }
.source :global(.highlighted .line-text) { text-decoration: underline; text-decoration-color: var(--dim); text-underline-offset: 3px; }
.source :global(.line-note-label) { color: var(--text); font-size: .8em; margin-left: 2ch; }
.note { margin: 0; padding: .75rem 0 1.5rem; overflow-wrap: anywhere; }
.note h2 { font: 800 1.5rem/1.2 var(--display); margin: 0 0 .3rem; }
.note p { margin: .5rem 0; }
/* In-flow grid is the no-JS / no-anchor fallback. The script reserves measured row height before
   anchoring so long notes can never collide with the following excerpt. */
@supports (top: anchor(top)) {
  /* CSS must switch to in-flow notes immediately, before the resize handler clears offsets. */
  @media (min-width: 801px) {
    .excerpt-row.anchored .note { position: absolute; top: anchor(top); left: var(--note-left); width: var(--note-width); }
  }
}
@media (max-width: 800px) {
  .excerpt-row { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .note { grid-row: 2; padding: .75rem 0 1.5rem; }
}
/* Shiki uses the explicit site theme, with the OS preference as the no-JS default. */
:global([data-theme="dark"] .case-study .astro-code span) { color: var(--shiki-dark) !important; }
@media (prefers-color-scheme: dark) { :global(html:not([data-theme="light"]) .case-study .astro-code span) { color: var(--shiki-dark) !important; } }
</style>
